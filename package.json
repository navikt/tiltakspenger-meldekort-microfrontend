{
  "name": "tiltakspenger-meldekort-microfrontend",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "lint": "eslint",
    "test": "vitest run",
    "mock": "tsx watch mock/server.ts",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "prettier": "prettier --write './src/**/*.{ts,tsx,astro}'"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/node": "11.1.4",
    "@astrojs/react": "6.0.4",
    "@navikt/aksel-icons": "8.16.1",
    "@navikt/ds-css": "8.16.1",
    "@navikt/ds-react": "8.16.1",
    "@navikt/nav-dekoratoren-moduler": "4.3.0",
    "@navikt/oasis": "4.1.4",
    "astro": "7.2.9",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hono/node-server": "2.1.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "3.1.0",
    "eslint-plugin-css-modules": "2.12.0",
    "globals": "17.11.0",
    "hono": "4.13.7",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "postcss": "8.5.26",
    "postcss-prefix-selector": "2.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ],
    "semi": true,
    "tabWidth": 4,
    "printWidth": 100,
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,astro}": [
      "eslint"
    ],
    "*.{ts,tsx,css,astro}": [
      "prettier --write"
    ]
  }
}
