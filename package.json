{
  "name": "tiltakspenger-meldekort-microfrontend",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "lint": "eslint",
    "test": "vitest run",
    "mock": "tsx watch mock/server.ts",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "prettier": "prettier --write './src/**/*.{ts,tsx,astro}'"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/node": "11.1.6",
    "@astrojs/react": "7.0.0",
    "@navikt/aksel-icons": "8.18.0",
    "@navikt/ds-css": "8.18.0",
    "@navikt/ds-react": "8.18.0",
    "@navikt/nav-dekoratoren-moduler": "4.5.0",
    "@navikt/oasis": "4.2.2",
    "astro": "7.3.5",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hono/node-server": "2.1.1",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-css-modules": "2.12.0",
    "globals": "17.12.0",
    "hono": "4.13.9",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "postcss": "8.5.28",
    "postcss-prefix-selector": "2.2.1",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ],
    "semi": true,
    "tabWidth": 4,
    "printWidth": 100,
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,astro}": [
      "eslint"
    ],
    "*.{ts,tsx,css,astro}": [
      "prettier --write"
    ]
  }
}
