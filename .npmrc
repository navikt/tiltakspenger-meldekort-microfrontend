@navikt:registry=https://npm.pkg.github.com
# Dependabot slår opp ALLE pakker mot npm.pkg.github.com (den genererte .npmrc-en i
# containeren, ikke denne fila). Offentlige pakker gir 404 der og resolvingen går videre,
# men @types/* ligger som utdaterte speilkopier som stopper på 17.0.11 fra 2021. pnpm får
# da et gyldig svar uten 19.x og feiler med ERR_PNPM_NO_MATCHING_VERSION i stedet for å gå
# videre. Scopet bindes derfor eksplisitt til npmjs, som er der pakkene faktisk vedlikeholdes.
@types:registry=https://registry.npmjs.org/
ignore-scripts=true
