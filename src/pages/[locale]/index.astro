---
import { Heading, BodyShort } from "@navikt/ds-react";
import { text } from "@src/language/text";
import { logger } from "@src/utils/logger";
import { getOboToken } from "@src/utils/token";
import { getDataFromAPI } from "@src/utils/fetch";
import { getMeldekortText } from "@src/utils/meldekortTekst";
import { MELDEKORT_API_URL } from "astro:env/server";
import { MELDEKORT_URL } from "astro:env/server";
import type { Language } from "@src/language/types";
import type { MeldekortKortInfo } from "@src/types/MeldekortType";
import styles from "@src/styles/index.module.css";
import "@src/styles/aksel.css";
import { isLocal } from "../../utils/environment";
import { ChevronRightIcon } from "@navikt/aksel-icons";

let data: MeldekortKortInfo;

// Tokenvekslingen må ligge inne i try-blokka: feiler TokenX utenfor, kaster den ubehandlet
// og Astro svarer 500 uten at vi får logget noe. Min side bytter inn fallback-siden ved
// begge statusene, men 503 er signalet vi faktisk mener, og logglinja er den som forklarer hvorfor.
try {
    const oboToken = await getOboToken(Astro.locals.token);
    const url = `${MELDEKORT_API_URL}/din-side/microfrontend/meldekort-kort-info`;
    data = await getDataFromAPI(oboToken, url);
} catch (error) {
    logger.error("Error fetching data: " + error);
    return new Response("Internal Server Error", { status: 503 });
}

const language = Astro.currentLocale as Language;
---

<>
    {isLocal && <meta charset="UTF-8" />}
    <div class="tiltakspenger-meldekort-microfrontend">
        <div class={styles.microfrontend}>
            <a href={MELDEKORT_URL}>
                <div class={styles.tittel}>
                    <Heading size="small" level="3">
                        {text.tittel[language]}
                    </Heading>
                </div>
                <div class={styles.body}>
                    <BodyShort>
                        <>
                            {getMeldekortText(data, language)}
                        </>
                    </BodyShort>
                    <ChevronRightIcon
                        className={styles.chevron}
                        aria-hidden="true"
                        fontSize="24px"
                    />
                </div>
            </a>
        </div>
    </div>
    <script>
        import { getAnalyticsInstance } from "@navikt/nav-dekoratoren-moduler";
        import { logger } from "@src/utils/logger";

        const analyticsLogger = getAnalyticsInstance("dekoratoren");

        // Dekoratoren-moduler 4 typer navigere-hendelsen mot @navikt/analytics-types.
        // komponent heter nå komponentId, kategori dekkes av lenkegruppe, og destinasjon er påkrevd.
        // Destinasjonen leses fra lenken som ble klikket, slik at feltet ikke blir en oppdiktet verdi.
        export const logEvent = (
            data: string,
            kategori: string,
            lenketekst: string,
            destinasjon: string,
        ) => {
            analyticsLogger("navigere", {
                komponentId: data,
                lenkegruppe: kategori,
                lenketekst: lenketekst,
                destinasjon: destinasjon,
            }).catch(() => logger.warn("Uninitialized amplitude"));
        };
        const microfrontend = document.querySelector("#microfrontend");

        microfrontend?.addEventListener("click", () => {
            const lenke = microfrontend.querySelector<HTMLAnchorElement>("a");
            logEvent("komponent", "kategori", "lenketekst", lenke?.href ?? "");
        });
    </script>
</>
