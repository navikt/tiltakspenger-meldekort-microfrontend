# Load nvm so node/pnpm are on PATH when git runs hooks in a non-interactive shell.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

# eslint-cachen gjør at bare endrede filer lintes på nytt.
pnpm exec eslint --cache --cache-location node_modules/.cache/eslint/
